#!/usr/bin/env bash
# Hook pre-commit LOCAL de CE depot.
#
# Une regression de hook ne doit pas pouvoir etre commitee. Le golden
# (tests/test_hooks.py) existait depuis le 27/07/2026 mais ne tournait qu'a la
# main et dans deploy.ps1 : on pouvait donc commiter un hook casse et ne le
# decouvrir qu'au deploiement suivant. Ce hook ferme ce trou.
#
# Il ne tourne QUE si le commit touche hooks/ ou tests/ : un commit de README
# n'a aucune raison de payer le golden.
#
# Installation (le shim global core.hooksPath enchaine sur ce fichier) :
#   cp githooks/pre-commit-local .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit

set -u
racine="$(git rev-parse --show-toplevel)"
# githooks/ ajoute le 25/08 : les shims git sont eux aussi des garde-fous, et
# tests/test_garde_fous_git.py est precisement la pour les surveiller.
concernes="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^(hooks/|tests/|githooks/)' || true)"

if [ -z "$concernes" ]; then
    exit 0
fi

lancer_suite() {
    # $1 = chemin du test, $2 = libelle
    local test="$1" libelle="$2" log="/tmp/golden-local.log"
    echo "pre-commit : $libelle..."
    if python "$test" > "$log" 2>&1; then
        return 0
    fi
    echo ""
    echo "REFUS : $libelle est ROUGE. Rien n'est commite." >&2
    # Ancres en debut de ligne : « echec » tout court matchait aussi des lignes OK
    # dont le libelle contient le mot (contre-epreuve du 25/08/2026).
    resume="$(grep -E "^FAIL|^ROUGE" "$log" | head -20)"
    if [ -n "$resume" ]; then
        echo "$resume" >&2
    else
        # La suite peut mourir sur une exception avant d'imprimer le moindre FAIL
        # (contre-epreuve : un `shutil.move` a la place d'un `copy2` fait disparaitre
        # le fichier que le test suivant relit). Sans ce repli, le refus etait muet.
        echo "  (suite interrompue avant son resume - fin du log :)" >&2
        tail -6 "$log" >&2
    fi
    echo "" >&2
    echo "  Detail complet : $log" >&2
    echo "  Relancer       : python $test" >&2
    return 1
}

lancer_suite "$racine/tests/test_hooks.py" "golden des hooks Claude Code" || exit 1
lancer_suite "$racine/tests/test_garde_fous_git.py" "garde-fous git (etage 2)" || exit 1
echo "pre-commit : les deux suites sont vertes."
exit 0
